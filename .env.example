# Local development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=generate-a-new-random-key-for-local-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Optional portfolio assistant (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional SMTP delivery for the contact inbox
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_RECIPIENT=

# Render: set DJANGO_DEBUG=False, DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS,
# RENDER_EXTERNAL_HOSTNAME (automatically provided by Render), and any API/mail values.
DATABASE_URL=
