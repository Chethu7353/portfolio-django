# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Resend HTTPS Email Configuration (Recommended for Render & Production)
# Render Free blocks SMTP ports (25, 465, 587); Resend uses HTTPS port 443.
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=onboarding@resend.dev
CONTACT_RECEIVER_EMAIL=your_inbox_email@gmail.com

# Django Core & Security Settings
DJANGO_SECRET_KEY=generate-a-new-random-secret-key-for-local-use
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Optional PostgreSQL Database URL
DATABASE_URL=
